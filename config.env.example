# ═══════════════════════════════════════════════════════
# THE EXHALE SANCTUARY — Environment Configuration
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# Never commit .env with real secrets to version control.

# ─── SUPABASE ───
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# ─── WEB3FORMS (Contact Email) ───
VITE_WEB3FORMS_KEY=your-web3forms-access-key-here

# ─── AUDIO CDN ───
# Optional: CDN URL for meditation audio file
# Leave empty to use local file fallback
VITE_AUDIO_CDN_URL=https://cdn.example.com/audio/

# ─── APP CONFIG ───
VITE_APP_NAME=The Exhale Sanctuary
VITE_APP_URL=https://exhalesanctuary.com

# ─── FEATURE FLAGS ───
VITE_ENABLE_BOOKMARKS=true
VITE_ENABLE_TIER_COMPARISON=true
